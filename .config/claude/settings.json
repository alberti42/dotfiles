{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "mcp__kicad",
      "mcp__dokuwiki__core_aclCheck",
      "mcp__dokuwiki__core_getAPIVersion",
      "mcp__dokuwiki__core_getMedia",
      "mcp__dokuwiki__core_getMediaInfo",
      "mcp__dokuwiki__core_getPage",
      "mcp__dokuwiki__core_getPageBackLinks",
      "mcp__dokuwiki__core_getPageHTML",
      "mcp__dokuwiki__core_getPageHistory",
      "mcp__dokuwiki__core_getPageInfo",
      "mcp__dokuwiki__core_getPageLinks",
      "mcp__dokuwiki__core_getRecentMediaChanges",
      "mcp__dokuwiki__core_getRecentPageChanges",
      "mcp__dokuwiki__core_getWikiTime",
      "mcp__dokuwiki__core_getWikiTitle",
      "mcp__dokuwiki__core_getWikiVersion",
      "mcp__dokuwiki__core_listMedia",
      "mcp__dokuwiki__core_listPages",
      "mcp__dokuwiki__core_searchPages",
      "mcp__dokuwiki__core_whoAmI",
      "mcp__dokuwiki__dokuwiki_getPagelist",
      "mcp__dokuwiki__dokuwiki_search",
      "mcp__dokuwiki__dokuwiki_getTime",
      "mcp__dokuwiki__dokuwiki_getTitle",
      "mcp__dokuwiki__dokuwiki_getVersion",
      "mcp__dokuwiki__dokuwiki_getXMLRPCAPIVersion",
      "mcp__dokuwiki__plugin_acl_listAcls",
      "mcp__dokuwiki__plugin_tagfilter_getPagesByTags",
      "mcp__dokuwiki__plugin_tagfilter_getPagesByRegExpTags",
      "mcp__dokuwiki__plugin_tagfilter_getTagsByPage",
      "mcp__dokuwiki__wiki_aclCheck",
      "mcp__dokuwiki__wiki_getAllPages",
      "mcp__dokuwiki__wiki_getAttachment",
      "mcp__dokuwiki__wiki_getAttachmentInfo",
      "mcp__dokuwiki__wiki_getAttachments",
      "mcp__dokuwiki__wiki_getBackLinks",
      "mcp__dokuwiki__wiki_getPage",
      "mcp__dokuwiki__wiki_getPageHTML",
      "mcp__dokuwiki__wiki_getPageHTMLVersion",
      "mcp__dokuwiki__wiki_getPageInfo",
      "mcp__dokuwiki__wiki_getPageInfoVersion",
      "mcp__dokuwiki__wiki_getPageVersion",
      "mcp__dokuwiki__wiki_getPageVersions",
      "mcp__dokuwiki__wiki_getRPCVersionSupported",
      "mcp__dokuwiki__wiki_getRecentChanges",
      "mcp__dokuwiki__wiki_getRecentMediaChanges",
      "mcp__dokuwiki__wiki_listLinks"
    ],
    "deny": [
      "mcp__dokuwiki__dokuwiki_createUser",
      "mcp__dokuwiki__dokuwiki_deleteUsers",
      "mcp__dokuwiki__plugin_usermanager_createUser",
      "mcp__dokuwiki__plugin_usermanager_deleteUser",
      "mcp__dokuwiki__plugin_acl_addAcl",
      "mcp__dokuwiki__plugin_acl_delAcl",
      "mcp__dokuwiki__core_deleteMedia",
      "mcp__dokuwiki__wiki_deleteAttachment",
      "mcp__dokuwiki__core_login",
      "mcp__dokuwiki__core_logoff",
      "mcp__dokuwiki__dokuwiki_login",
      "mcp__dokuwiki__dokuwiki_logoff"
    ],
    "ask": [
      "mcp__dokuwiki__core_savePage",
      "mcp__dokuwiki__core_appendPage",
      "mcp__dokuwiki__dokuwiki_appendPage",
      "mcp__dokuwiki__wiki_putPage",
      "mcp__dokuwiki__core_saveMedia",
      "mcp__dokuwiki__wiki_putAttachment",
      "mcp__dokuwiki__core_lockPages",
      "mcp__dokuwiki__core_unlockPages",
      "mcp__dokuwiki__dokuwiki_setLocks"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/claude-notifier.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/claude-notifier.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/claude-notifier.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/claude-notifier.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/claude-notifier.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh \"$HOME/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "light-ansi",
  "verbose": false,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: PUBLIC — alberti42/org-semantic (github.com:alberti42/org-semantic.git)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured (CI references APPLE_ID, APPLE_ID_PASSWORD, CERTIFICATE_BASE64, CERTIFICATE_PASSWORD as secret names only, no values)",
      "**Default / protected branches**: main (default); no rulesets listed, no protected branches listed via gh",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo (alberti42/org-semantic on github.com) and its remote(s) only — no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: /Users/andrea/Documents/Programming/Emacs/org-semantic (public repo alberti42/org-semantic on github.com) — since this repo is PUBLIC, only this repo's own work is safe to push here; secrets and sensitive personal/entrusted data are never cleared into it regardless of visibility",
      "**Org-specific CLIs**: None configured"
    ]
  }
}
