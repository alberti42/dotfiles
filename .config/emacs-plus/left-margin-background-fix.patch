From 452a08650adcdfe79cccc0f1560770beb2599d9d Mon Sep 17 00:00:00 2001
From: Andrea Alberti <a.alberti82@gmail.com>
Date: Sat, 28 Mar 2026 18:29:43 +0100
Subject: [PATCH] Fill left-margin characters with 'line-number' face
 background

Unfilled characters in the left-margin column now use the
'line-number' face background instead of the frame default; the
changes apply to both TTY and GUI Emacs.  When a theme gives the
'line-number' face a distinct background (as 'modus-operandi',
'modus-vivendi', and many others do), the previous behavior produced a
visually inconsistent background color for the left margin.

The 'line-number' face is the natural and canonical choice for the
left-margin background.  When its background matches the frame
background (i.e., the user has not customized it), the existing
behavior is preserved.

The intent is analogous to how Emacs fills the line-number column
beyond EOB: in both cases, characters in the left-margin area that
would otherwise show the frame default background are filled with the
'line-number' face; the difference is only in which code path performs
the fill (compare 'maybe_produce_line_number').

* src/xdisp.c (extend_face_to_end_of_line): Compute
'margin_fill_face_id' from the 'line-number' face via 'merge_faces'.
Widen the left-margin fill condition to also trigger when the
'line-number' face background differs from the frame background.  Fill
empty left-margin characters with 'margin_fill_face_id' instead of the
default face.
(display_line): Also call 'extend_face_to_end_of_line' for beyond-EOB
rows when the window has a left margin, so empty margin characters are
filled with the 'line-number' face background.
---
 etc/NEWS    | 12 ++++++++
 src/xdisp.c | 85 ++++++++++++++++++++++++++++++++++++++++-------------
 2 files changed, 77 insertions(+), 20 deletions(-)

diff --git a/etc/NEWS b/etc/NEWS
index 2b4e81fee14..90b29f17e34 100644
--- a/etc/NEWS
+++ b/etc/NEWS
@@ -24,6 +24,18 @@ applies, and please also update docstrings as needed.
 
 * Installation Changes in Emacs 31.1
 
+---
+** Empty left-margin characters now use the 'line-number' face background.
+Previously, rows with empty characters in the left-margin area (e.g.,
+lines beyond end-of-buffer, or unchanged lines when a VCS-indicator
+package reserves a left-margin column but placed no change indicator)
+showed the frame default background in that column.  When a theme gives
+'line-number' a distinct background - as built-in 'modus-operandi',
+'modus-vivendi', and many others do - this produced a visually
+inconsistent left margin.  The margin column now uses the 'line-number'
+face background, keeping the left margin uniform.  The fix applies to
+both TTY and GUI frames.
+
 +++
 ** Unexec dumper removed.
 The traditional unexec dumper, deprecated since Emacs 27, has been
diff --git a/src/xdisp.c b/src/xdisp.c
index 4f2c5c39900..6b4df2d1b9e 100644
--- a/src/xdisp.c
+++ b/src/xdisp.c
@@ -24337,6 +24337,24 @@ extend_face_to_end_of_line (struct it *it)
                                         ? it->saved_face_id
                                         : extend_face_id));
 
+  /* Use the 'line-number' face to fill empty characters in the
+     left-margin column.  That face is the canonical left-margin
+     background: it is already used for line-number digits.  Many modern
+     themes (e.g., the built-in 'modus-operandi') give it a background
+     distinct from the frame default.  Without this fill, empty margin
+     characters fall back to the default face, producing a color
+     mismatch.  The intent is analogous to how Emacs fills the
+     line-number column beyond end-of-buffer (EOB): in both cases,
+     characters in the left-margin area that would otherwise show the
+     frame default background are filled with the 'line-number' face;
+     the difference is only in which code path performs the fill
+     (compare 'maybe_produce_line_number').  Using the 'line-number'
+     face here has the merit that no separate variable is needed.  */
+  int margin_fill_face_id =
+    merge_faces (it->w, Qline_number, 0, DEFAULT_FACE_ID);
+
+  /* TODO: several conditions of this early return lack documentation.  */
+  /* Skip if 'line-number' background matches the frame default.  */
   if (FRAME_WINDOW_P (f)
       && MATRIX_ROW_DISPLAYS_TEXT_P (it->glyph_row)
       && face->box == FACE_NO_BOX
@@ -24348,7 +24366,10 @@ extend_face_to_end_of_line (struct it *it)
       && !face->stipple
 #endif
       && !it->glyph_row->reversed_p
-      && !display_fill_column_indicator)
+      && !display_fill_column_indicator
+      && !(WINDOW_LEFT_MARGIN_WIDTH (it->w) > 0
+	   && FACE_FROM_ID (f, margin_fill_face_id)->background
+	   != FRAME_BACKGROUND_PIXEL (f)))
     return;
 
   /* Set the glyph row flag indicating that the face of the last glyph
@@ -24388,14 +24409,26 @@ extend_face_to_end_of_line (struct it *it)
 #endif
 	    ))
 	{
-	  if (WINDOW_LEFT_MARGIN_WIDTH (it->w) > 0
-	      && it->glyph_row->used[LEFT_MARGIN_AREA] == 0)
-	    {
-	      it->glyph_row->glyphs[LEFT_MARGIN_AREA][0] = space_glyph;
-	      it->glyph_row->glyphs[LEFT_MARGIN_AREA][0].face_id =
-		default_face->id;
-	      it->glyph_row->glyphs[LEFT_MARGIN_AREA][0].frame = f;
-	      it->glyph_row->used[LEFT_MARGIN_AREA] = 1;
+	  /* The third condition is a safety bound preventing writes
+	     past the end of the left-margin glyph array.  In the
+	     non-window-system branch the equivalent bound is expressed
+	     via a pointer 'g' initialized to the first empty slot and
+	     advanced by 'g++', so the limit arises naturally from the
+	     iteration.  Here we index by 'n = used' directly and
+	     recompute the equivalent pointer bound inline.  */
+	  while (WINDOW_LEFT_MARGIN_WIDTH (it->w) > 0
+		 && (it->glyph_row->used[LEFT_MARGIN_AREA]
+		     < WINDOW_LEFT_MARGIN_WIDTH (it->w))
+		 && (it->glyph_row->glyphs[LEFT_MARGIN_AREA]
+		     + it->glyph_row->used[LEFT_MARGIN_AREA]
+		     < it->glyph_row->glyphs[TEXT_AREA]))
+	    {
+	      int n = it->glyph_row->used[LEFT_MARGIN_AREA];
+	      it->glyph_row->glyphs[LEFT_MARGIN_AREA][n] = space_glyph;
+	      it->glyph_row->glyphs[LEFT_MARGIN_AREA][n].face_id =
+		margin_fill_face_id;
+	      it->glyph_row->glyphs[LEFT_MARGIN_AREA][n].frame = f;
+	      it->glyph_row->used[LEFT_MARGIN_AREA]++;
 	    }
 	  if (WINDOW_RIGHT_MARGIN_WIDTH (it->w) > 0
 	      && it->glyph_row->used[RIGHT_MARGIN_AREA] == 0)
@@ -24573,15 +24606,23 @@ extend_face_to_end_of_line (struct it *it)
       it->c = it->char_to_display = ' ';
       it->len = 1;
 
+      /* TODO: several conditions of this fill block lack documentation.  */
+      /* Skip if 'line-number' background matches the frame default.  */
       if (WINDOW_LEFT_MARGIN_WIDTH (it->w) > 0
 	  && (it->glyph_row->used[LEFT_MARGIN_AREA]
 	      < WINDOW_LEFT_MARGIN_WIDTH (it->w))
 	  && !it->glyph_row->mode_line_p
-	  && face->background != FRAME_BACKGROUND_PIXEL (f))
+	  && (face->background != FRAME_BACKGROUND_PIXEL (f)
+	      || FACE_FROM_ID (f, margin_fill_face_id)->background
+	         != FRAME_BACKGROUND_PIXEL (f)))
 	{
 	  struct glyph *g = it->glyph_row->glyphs[LEFT_MARGIN_AREA];
 	  struct glyph *e = g + it->glyph_row->used[LEFT_MARGIN_AREA];
 
+	  /* TODO: since this is the non-window-system branch,
+	     pixel_width is always 1, so this loop could be simplified
+	     to: it->current_x = it->glyph_row->used[LEFT_MARGIN_AREA];
+	     The declaration of 'e' above could then be dropped.  */
 	  for (it->current_x = 0; g < e; g++)
 	    it->current_x += g->pixel_width;
 
@@ -24590,7 +24631,7 @@ extend_face_to_end_of_line (struct it *it)
 	    it->wrap_prefix_width = it->current_x;
 
 	  it->area = LEFT_MARGIN_AREA;
-	  it->face_id = default_face->id;
+	  it->face_id = margin_fill_face_id;
 	  while (it->glyph_row->used[LEFT_MARGIN_AREA]
 		 < WINDOW_LEFT_MARGIN_WIDTH (it->w)
 		 && g < it->glyph_row->glyphs[TEXT_AREA])
@@ -25910,17 +25951,21 @@ #define RECORD_MAX_MIN_POS(IT)					\
 	  it->font_height = Qnil;
 	  it->voffset = 0;
 	  row->ends_at_zv_p = true;
-	  /* A row that displays right-to-left text must always have
-	     its last face extended all the way to the end of line,
-	     even if this row ends in ZV, because we still write to
-	     the screen left to right.  We also need to extend the
-	     last face if the default face is remapped to some
-	     different face, otherwise the functions that clear
-	     portions of the screen will clear with the default face's
-	     background color.  */
+	  /* A row that displays right-to-left text must always have its
+	     last face extended all the way to the end of line, even if
+	     this row ends in ZV, because we still write to the screen
+	     left to right.  We also need to extend the last face if the
+	     default face is remapped to some different face, otherwise
+	     the functions that clear portions of the screen will clear
+	     with the default face's background color.  Independently,
+	     we also extend face to EOL when the window has a left
+	     margin so that rows with empty characters (e.g. rows beyond
+	     EOB) fill the margin column with the 'line-number' face
+	     background rather than the frame default background.  */
 	  if (row->reversed_p
 	      || lookup_basic_face (it->w, it->f, DEFAULT_FACE_ID)
-              != DEFAULT_FACE_ID)
+              != DEFAULT_FACE_ID
+	      || WINDOW_LEFT_MARGIN_WIDTH (it->w) > 0)
 	    extend_face_to_end_of_line (it);
 	  break;
 	}
