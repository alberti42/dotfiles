{
  "$schema": "https://raw.githubusercontent.com/google-gemini/gemini-cli/main/schemas/settings.schema.json",
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "general": {
    "sessionRetention": {
      "enabled": true,
      "maxAge": "30d"
    },
    "preferredEditor": "emacsclient",
    "defaultApprovalMode": "auto_edit",
    "enableNotifications": true
  },
  "ui": {
    "inlineThinkingMode": "full",
    "dynamicWindowTitle": true,
    "footer": {
      "hideContextPercentage": false
    },
    "showLineNumbers": false,
    "useAlternateBuffer": false,
    "autoThemeSwitching": false,
    "terminalBackgroundPollingInterval": 60,
    "theme": "Default Light"
  },
  "mcp": {
    "excluded": []
  },
  "mcpServers": {
    "context7": {
      "command": "bash",
      "args": [
        "-c",
        "test -f \"$HOME/.config/envs/context7.sh\" && source \"$HOME/.config/envs/context7.sh\" && exec npx -y @upstash/context7-mcp"
      ]
    }
  }
}