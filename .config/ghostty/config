# ~/.config/ghostty/config
#
# Shared settings. Per-OS settings (font size, default program, platform
# keybindings) live in config-macos / config-linux; links.conf links the one for
# this OS to ~/.config/ghostty/platform, which is loaded at the end of this file.

# --- Font ---
font-family = "JetBrainsMonoNL Nerd Font Mono"
font-style  = Regular
# font-size is set per OS: macOS points are 1/72", Linux ones use the real DPI,
# so the same number renders ~1.33x bigger on Linux.

# --- Colors / theme ---
# Catppuccin Latte (light) / Frappe (dark), following the OS appearance.
theme = light:Catppuccin Latte,dark:Catppuccin Frappe

# Cursor in the foreground color, so it adapts to both themes.
cursor-color = cell-foreground

# --- Cursor ---
# The blink rate isn't configurable in Ghostty.
cursor-style       = block
cursor-style-blink = true

# --- Scrollback ---
# In BYTES, not lines. ~10 MB is also Ghostty's default.
scrollback-limit = 10000000

# --- Terminal type ---
# xterm-256color rather than xterm-ghostty, for tmux/SSH compatibility.
term = xterm-256color

# --- Window / appearance ---
background-opacity = 1
window-padding-x = 15
window-padding-y = 10
macos-titlebar-style = hidden
confirm-close-surface = false

# window-width / window-height are in GRID CELLS, so they depend on the font
# size; config-linux sets them. Ghostty cannot center a window: on Linux, GNOME
# centers new windows (org.gnome.mutter center-new-windows), and
# window-position-x/y work on macOS only.

# --- Mouse ---
mouse-hide-while-typing = false
# Links open with Cmd+click; inside tmux (mouse on) they need Cmd+Shift+click.

# --- macOS Option/Alt behavior ---
# LEFT option acts as Alt; RIGHT option still composes special characters.
macos-option-as-alt = left

# --- Clipboard ---
clipboard-read  = allow
clipboard-write = allow

# --- Default program (tmux) ---
# Set per OS in config-macos / config-linux.

# --- Keybindings ---
# `keybind = clear` drops all Ghostty defaults; only the bindings below (and the
# per-OS ones) are active.
keybind = clear

# tmux prev/next pane: Ctrl-b p / Ctrl-b n
keybind = ctrl+alt+left_bracket=text:\x02p
keybind = ctrl+alt+right_bracket=text:\x02n

# Disable Alt+Enter (no fullscreen toggle here)
keybind = alt+enter=ignore

# CSI u encodings (enable in tmux with: printf '\e[>4;1m')
keybind = ctrl+tab=text:\x1b[9;5u
keybind = shift+enter=text:\x1b[13;2u

# Copy/paste, quit/close, inspector and fullscreen are set per OS.

# --- Per-OS settings ---
# `platform` is not a Ghostty feature, just a file name: links.conf points
# ~/.config/ghostty/platform at config-macos or config-linux. Ghostty loads a
# config-file after this whole file, wherever the line is, so it overrides the
# settings above. `?` makes it optional: without the link (links.zsh install not
# run yet), Ghostty starts with the shared settings instead of reporting an error.
config-file = ?platform
