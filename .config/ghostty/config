# ~/.config/ghostty/config

# --- Font ---
font-family = "MesloLGS NF"
font-size   = 17

# --- Colors (WezTerm → Ghostty theme overrides) ---
foreground = #ffffff
background = #111111

cursor-color = #ffffff
cursor-text  = #000000

# ANSI 0–15
# palette = 0  = #000000
# palette = 1  = #c91b00
# palette = 2  = #00c300
# palette = 3  = #c7c400
# palette = 4  = #0226c8
# palette = 5  = #ca30c7
# palette = 6  = #00c5c8
# palette = 7  = #c7c7c7
# palette = 8  = #686868
# palette = 9  = #ff6e68
# palette = 10 = #60fa67
# palette = 11 = #fffc67
# palette = 12 = #6872ff
# palette = 13 = #ff77ff
# palette = 14 = #5ffdff
# palette = 15 = #ffffff

# --- Cursor ---
# cursor-style       = bar      # WezTerm SteadyBar
# cursor-style-blink = false    # WezTerm blink_rate=250 → “no blink”

# --- Scrollback ---
scrollback-limit = 10000

# --- Window / appearance ---
background-opacity = 1
# window-decoration  = auto     # closest to WezTerm 'RESIZE'
window-padding-x   = 15
window-padding-y   = 15
# confirm-close-surface = false # WezTerm NeverPrompt

# Start roughly centered and sized.
# Ghostty sizes by GRID CELLS, not pixels. Tweak to taste.
# (These two only take effect together.)
window-width  = 120
window-height = 50

# Optional explicit placement (pixels from top-left of primary monitor).
# Uncomment and set if you want a fixed position.
# window-position-x = 200
# window-position-y = 120

# --- Tabs / bar ---
# Ghostty shows tabs only when you open them; there isn't a global "hide all tabs" switch.

# --- Bell ---
# Newer Ghostty builds allow disabling bell UI entirely on macOS:
# app-notifications = false
# (and keep confirm-close-surface=false above)

# --- Clipboard / mouse ---
# clipboard-read  = true
# clipboard-write = true
mouse-hide-while-typing = false

# --- macOS Option/Alt behavior ---
# WezTerm: left Alt = composed (false), right Alt = Alt (true)
macos-option-as-alt = right

# --- Default program (tmux launcher) ---
# Runs ONLY for the first surface; use `command` to apply to all windows.
# Prefer absolute paths; tilde/$HOME isn’t expanded by Ghostty.
initial-command = "$HOME/.config/dotfiles/.local/bin/tmux_launcher -l new-session -A -D -s main"

# --- Keybindings ---
# Syntax: keybind = <modifiers+key>=<action>
# To send raw bytes, use text:\x.. (Zig string literal escapes).

# Word-wise movement with Alt+←/→ (esc+b, esc/f)
# keybind = alt+left  = text:\x1bb
# keybind = alt+right = text:\x1bf

# tmux pane cycling: send Ctrl-b p / Ctrl-b n
# keybind = alt+super+left  = text:\x02p
# keybind = alt+super+right = text:\x02n
# keybind = ctrl+alt+[ = text:\x02p
# keybind = ctrl+alt+] = text:\x02n
# keybind = alt+super+[ = text:\x02p
# keybind = alt+super+] = text:\x02n

# Disable Alt+Enter (WezTerm used this for fullscreen)
# keybind = alt+enter = ignore

# Copy / Paste
# keybind = cmd+c = copy_to_clipboard
# keybind = cmd+v = paste_from_clipboard

# Close window (WezTerm Cmd+w)
# keybind = cmd+w = close_window

# Disable Cmd+n (new window)
# keybind = cmd+n = ignore

# Quit app (like WezTerm Cmd+q)
# keybind = cmd+q = quit

# Find/search: Ghostty doesn't have an in-terminal "find" UI yet, so Cmd+F is left unmapped.
# If you prefer, you can block it to avoid accidental app-level search in some envs:
# keybind = cmd+f = ignore
