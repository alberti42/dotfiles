{
  "$schema": "https://opencode.ai/config.json",
  "permission": {               // documentation of tools → https://github.com/anomalyco/opencode/tree/dev/packages/opencode/src/tool
    "*": "ask",                 // fallback case
    "read": {                   // reading a file (matches the file path)
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
    },
    "edit": {                   // all file modifications (covers edit, write, patch, multiedit)
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "/etc/": "ask",
      "/opt/homebrew/etc/": "ask",
    },             
    "glob": "allow",             // file globbing (matches the glob pattern)
    "grep": "allow",             // content search (matches the regex pattern)
    "list": "allow",             // listing files in a directory (matches the directory path)
    "bash": {                    // running shell commands (matches parsed commands like git status --porcelain)
      "*": "ask",
      "git *": "ask",
      "git checkout *": "allow",
      "git clone *": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "git show *": "allow",
      "git diff *": "allow",
      "npm *": "allow",
      "rm *": "deny",
      "grep *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "mkdir *": "allow",
    },             
    "task": "allow",             // launching subagents (matches the subagent type)
    "skill": "ask",              // loading a skill (matches the skill name)
    "lsp": "allow",              // running LSP queries (currently non-granular)
    "todoread": "allow",         // reading the todo list
    "todowrite": "allow",        // writing the todo list
    "webfetch": "allow",         // fetching a URL (matches the URL)
    "websearch": "allow",        // web search (matches the query)
    "codesearch": "allow",       // code search (matches the query)
    "external_directory": {      // triggered when a tool touches paths outside the project working directory
      "*": "ask",
      "~/Downloads/*": "allow",
      "/tmp/*": "allow"
    },
    "doom_loop": "ask"           // triggered when the same tool call repeats 3 times with identical input
  },
  "agent": {
    "plan": {
      "permission": { 
        "edit": "deny",
        "bash": {                // running shell commands (matches parsed commands like git status --porcelain)
          "*": "deny",
          "git log *": "allow",
          "git status *": "allow",
          "grep *": "allow",
          "ls *": "allow",
          "cat *": "allow",
        },
        "task": "ask",           // launching subagents (matches the subagent type)
        "todowrite": "ask"       // writing the todo list
      }
    },
  },
  "mcp": {
    "knuspr": {
      "type": "remote",
      "url": "https://mcp.knuspr.de/mcp/",
      "enabled": true,
      "headers": {
        "rhl-email": "...",
        "rhl-pass": "..."
      }
    }
  }
}
