#!/bin/zsh -fd

# ("${(@f)$(...)}") — zsh idiom to split command output on newlines into an array
declare -a claude_paths=("${(@f)$(whence -a claude)}")
# EDITOR export
export EDITOR="$HOME/.local/bin/emacsclient -nw -c"
# exec $claude_paths[2] — executes the second entry (the real claude binary, not this wrapper)
exec $claude_paths[2] "$@"
