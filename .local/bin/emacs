#!/bin/zsh -fd
export TERM=xterm-emacs
path=(${path:#${0:h}})
{
  # Report modifiers for "other" keys
  printf '\e[>4;1m'
  if [[ -n $INSIDE_claude ]]; then
    emacs "$@"
  else
    exec emacs "$@"
  fi
} always {
  if [[ -n $INSIDE_claude ]]; then
    # If inside Claude Code, restore report modifiers for all keys
    printf '\e[>4;2m'
  fi
}
