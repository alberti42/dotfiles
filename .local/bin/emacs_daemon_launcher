#!/hint/zsh -ld

# Hint shebang: login shell (-l) and skip global startup files (-d).
# When launched via launchd with `/bin/zsh -ld ...`, this file's shebang is ignored.
# With -d, zsh will read user login files (e.g. ~/.zprofile) but not /etc/zprofile.

. "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/interactive-shell-env.sh"
. "${XDG_CONFIG_HOME:-$HOME/.config}/envs/LanguageTools.sh"
export TERM=xterm-256color
# COLORTERM must be set explicitly here: the daemon is launched by launchd,
# not from a terminal, so it does not inherit the COLORTERM=truecolor that
# WezTerm normally injects into interactive shell sessions.
export COLORTERM=truecolor
exec emacs --fg-daemon
