#!/bin/zsh -fd

# ("${(@f)$(...)}") — zsh idiom to split command output on newlines into an array
declare -a oc_paths=("${(@f)$(whence -a opencode)}")
# EDITOR export
export EDITOR="$HOME/.local/bin/emacsclient -nw -c"
# exec $opencode[1] — executes the first entry (the real opencode binary, not this wrapper)

exec $oc_paths[1] attach http://localhost:4096 --dir . "$@"
