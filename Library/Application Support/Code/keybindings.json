// Place your key bindings in this file to override the defaultsauto[]
[
    {
        "key": "i i",
        "command": "notebook.cancelExecution",
        "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
    },
    {
        "key": "delete delete",
        "command": "notebook.cell.clearOutputs",
        "when": "notebookCellEditable && notebookCellHasOutputs && notebookEditable && notebookEditorFocused && !inputFocus"
    },
    {
        "key": "backspace backspace",
        "command": "notebook.cell.delete",
        "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
    },
    {
        "key": "ctrl+up",
        "command": "notebook.cell.moveUp",
        "when": "notebookEditorFocused && !inputFocus"
    },
    {
        "key": "ctrl+down",
        "command": "notebook.cell.moveDown",
        "when": "notebookEditorFocused && !inputFocus"
    },
    {
        "key": "cmd+shift+t",
        "command": "workbench.action.terminal.newWithCwd",
        "args": {
            "cwd": "${fileDirname}"
        }
    },
    {
        "key": "shift+cmd+c",
        "command": "-workbench.action.terminal.openNativeConsole",
        "when": "!terminalFocus"
    },
    {
        "key": "alt+cmd+b",
        "command": "latex-workshop.build",
        "when": "!virtualWorkspace && editorLangId =~ /^build$|^latex$|^latex-class$|^latex-package$|^context$|^latex-expl3$|^doctex$|^rsweave$|^jlweave$|^pweave$/"
    },
    {
        "key": "cmd+shift+r",
        "command": "editor.action.insertSnippet",
        "when": "editorHasSelection && editorLangId == 'latex'",
        "args": {
            "snippet": "\\result[${1:1}]{${TM_SELECTED_TEXT}}"
        }
    },
    {
        "key": "cmd+shift+b",
        "when": "editorLangId == latex && editorHasSelection",
        "command": "editor.action.insertSnippet",
        "args": {
            "snippet": "\\quotedblock{${1:block_label}}{$TM_SELECTED_TEXT}"
        }
    },
    // {
    //     "key": "cmd+alt+r",
    //     "when": "editorLangId == latex && editorHasSelection",
    //     "command": "editor.action.insertSnippet",
    //     "args": {
    //         "snippet": "\\begin{referee}\n$TM_SELECTED_TEXT\n\\end{referee}"
    //     }
    // },
    {
        "key": "shift+cmd+f",
        "command": "-workbench.action.findInFiles"
    },
    {
        "key": "shift+cmd+f",
        "command": "search.action.openEditor"
    },
    {
        "key": "alt+cmd+n",
        "command": "workbench.files.action.showActiveFileInExplorer"
    },
    {
        "key": "alt+cmd+e",
        "command": "revealFileInOS"
    },
    {
        "key": "alt+cmd+r",
        "command": "-revealFileInOS",
        "when": "!editorFocus"
    },
    {
        "key": "alt+up",
        "command": "-editor.action.moveLinesUpAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "alt+down",
        "command": "-editor.action.moveLinesDownAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "shift+alt+down",
        "command": "-editor.action.copyLinesDownAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "shift+alt+up",
        "command": "-editor.action.copyLinesUpAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+shift+[",    // whatever keybinding you want
        "command": "cursorMove",
        "args": {
            "to": "prevBlankLine",
            "select": true         // false is the default if omitted
        },
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+up",
        "command": "cursorMove",
        "args": {
            "to": "prevBlankLine",
            "select": false
        },
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+down",
        "command": "cursorMove",
        "args": {
            "to": "nextBlankLine",
            "select": false
        },
        "when": "editorTextFocus"
    },
    {
        "key": "shift+cmd+enter",
        "command": "notebook.cell.executeAndSelectBelow",
        "when": "notebookCellType == 'markup' || notebookMissingKernelExtension && !notebookCellExecuting && notebookCellType == 'code' || !notebookCellExecuting && notebookCellType == 'code' && notebookKernelCount > 0 || !notebookCellExecuting && notebookCellType == 'code' && notebookKernelSourceCount > 0"
    },
    {
        "key": "cmd+enter",
        "command": "notebook.cell.executeAndFocusContainer",
        "when": "notebookMissingKernelExtension && !notebookCellExecuting && notebookCellType == 'code' || !notebookCellExecuting && notebookCellType == 'code' && notebookKernelCount > 0 || !notebookCellExecuting && notebookCellType == 'code' && notebookKernelSourceCount > 0"
    },
    {
        "key": "cmd+alt+t",
        "command": "workbench.action.tasks.runTask",
        "args": "New Tmux Window + Focus WezTerm"
    },
    {
        "key": "ctrl+shift+p",
        "command": "editor.action.inspectTMScopes"
    }
]