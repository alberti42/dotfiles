<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<false/>
	<key>Label</key>
	<string>com.alberti42.tmux_launcher</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>--noprofile</string>
		<string>--norc</string>
		<string>-c</string>
		<string>cd $HOME; $HOME/google-drive/dotfiles/.local/bin/tmux_launcher new-session -d -smain</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/tmux-launcher.err</string>
	<key>StandardOutPath</key>
	<string>/tmp/tmux-launcher.out</string>
</dict>
</plist>
