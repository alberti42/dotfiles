    // >>> TERMINUS >>>
    { 
        "keys": ["alt+`"],
        "command": "toggle_terminus_panel",
        "args": {
            "cwd": "${file_path:${folder}}"
        }
    },
    { 
        "keys": ["super+shift+t"],
        "command": "terminus_open",
        "args": {
        		"config_name": "Zsh",
            "cwd": "${file_path:${folder}}",
        }
    },
    { 
        "keys": ["ctrl+alt+t"],
        "command": "terminus_open",
        "args": {
            "cmd": "ipython3",
            "cwd": "${file_path:${folder}}"
        }
    },
    {
        "keys": ["super+b"],
        "command": "build_with_terminus",
        "context": [
            { "key": "setting.terminus_build", "operator": "equal", "operand": true }
        ]
    },
    // >>> ORIGAMI >>>
    // 
	  // --- Move focus between panes: Ctrl-b + arrow (like tmux) ---
	  { "keys": ["ctrl+b", "up"],    "command": "travel_to_pane", "args": {"direction": "up"} },
	  { "keys": ["ctrl+b", "right"], "command": "travel_to_pane", "args": {"direction": "right"} },
	  { "keys": ["ctrl+b", "down"],  "command": "travel_to_pane", "args": {"direction": "down"} },
	  { "keys": ["ctrl+b", "left"],  "command": "travel_to_pane", "args": {"direction": "left"} },

	  // --- Create/split panes (tmux semantics) ---
	  // Ctrl-b %  -> split vertically -> new pane on the RIGHT
	  { "keys": ["ctrl+b", "%"],   "command": "create_pane", "args": {"direction": "right", "give_focus": true} },

	  // Ctrl-b "  -> split horizontally -> new pane BELOW
	  // (On US keyboards, this is Shift + '  )
	  { "keys": ["ctrl+b", "\""],   "command": "create_pane", "args": {"direction": "down", "give_focus": true} },

	  // --- Kill current pane (tmux: Ctrl-b x). This avoids clobbering plain Ctrl-x "Cut" ---
	  { "keys": ["ctrl+b", "x"], "command": "destroy_pane", "args": {"direction": "self"} },

	  // --- New Sublime window (tmux: Ctrl-b c) ---
	  { "keys": ["ctrl+b", "c"], "command": "new_file" }
		// <<< ORIGAMI <<<

]
