{
  "theme": "adaptive",
  "brighten_bold_text": false,
  "default_config": {
    "osx": "Zsh",
    "linux": "Zsh",
    "windows": "Command Prompt"
  },
  "shell_configs": [
    {
      "name": "Zsh",
      "cmd": ["zsh", "-i", "-l"],
      "env": {"COLORTERM": "truecolor"},
      "enable": true,
      "platforms": ["linux", "osx"],
    },
    {
      "name": "Command Prompt",
      "cmd": "cmd.exe",
      "env": {},
      "enable": true,
      "platforms": ["windows"],
    },
    {
      "name": "PowerShell Core",
      "cmd": "pwsh.exe",
      "env": {},
      "enable": true,
      "platforms": ["windows"],
    },
    {
      "name": "PowerShell",
      "cmd": "powershell.exe",
      "env": {},
      "enable": true,
      "platforms": ["windows"],
    },
    {
      "name": "Cmder",
      "cmd": ["cmd.exe", "/k", "%CMDER_ROOT%\\vendor\\init.bat"],
      "env": {},
      "enable": false,
      "platforms": ["windows"],
    },
    {
      "name": "WSL Login Shell",
      "cmd": "wsl.exe",
      "env": {},
      "enable": true,
      "platforms": ["windows"],
    }
  ],
}
