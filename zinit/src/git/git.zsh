# Writes ~/.config/git/version.gitconfig, which .config/git/config includes, with
# the settings that depend on the git version. The file is rewritten when it is
# missing or older than the git binary (e.g. after an upgrade).

() {
  local git=${commands[git]-} out=$HOME/.config/git/version.gitconfig
  [[ -n $git && -d ${out:h} ]] || return 0
  [[ -f $out && ! $git -nt $out ]] && return 0

  # "git version 2.39.5 (Apple Git-154)" -> (2 39 5)
  local -a v=( ${(s:.:)${${(z)"$(command git --version 2>/dev/null)"}[3]-}} )
  (( $#v >= 2 )) || return 0

  {
    print -r -- "# Generated by $DOTFILES_DIR/zinit/src/git/git.zsh for git ${(j:.:)v}; do not edit."
    # zdiff3 exists since git 2.35; older versions reject the whole config
    if (( v[1] > 2 || (v[1] == 2 && v[2] >= 35) )); then
      print -r -- '[merge]'
      print -r -- '	conflictStyle = zdiff3'
    fi
  } >| $out.tmp.$$ && command mv -f -- $out.tmp.$$ $out
}

